#!/usr/bin/env sh
# Runs the CI checks that the staged paths can affect. Needs Bun and Node;
# CI stays the final gate.
set -e

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

STAGED="$(git diff --cached --name-only --diff-filter=ACMRD)"
staged() {
  printf '%s\n' "$STAGED" | grep -qE "$1"
}

# Bun lockfiles drift across Bun versions, so dependency edits need the pin.
if staged '(^|/)(package\.json|bun\.lock)$'; then
  EXPECTED_BUN="$(node -p "require('./package.json').packageManager.split('@')[1]")"
  ACTUAL_BUN="$(bun --version 2>/dev/null || echo missing)"
  if [ "$EXPECTED_BUN" != "$ACTUAL_BUN" ]; then
    echo "❌ bun is $ACTUAL_BUN; package.json pins bun@$EXPECTED_BUN."
    echo "   Install the pinned version and re-commit:"
    echo "   curl -fsSL https://bun.sh/install | bash -s \"bun-v$EXPECTED_BUN\""
    exit 1
  fi
fi

# Inputs of the parity audit: code, docs, agent surfaces, and workflows.
if staged '^(\.claude/|\.codex/|\.gemini/|\.github/(workflows|actions)/|\.gitignore$|[A-Z_]+\.md$|((\.github|dev)/)?\.?codecov\.ya?ml$|llms(-full)?\.txt$|openiap-versions\.json$|package\.json$|knowledge/|libraries/|packages/|plugins/|scripts/|security/|specs/)'; then
  echo "🔎 SDK parity audit…"
  node scripts/audit-non-godot-parity.mjs
fi

# The layout audit reads the directory tree and the trees drawn in two docs.
if [ -n "$(git diff --cached --name-only --diff-filter=ADR)" ] \
  || staged '^(AGENTS\.md|knowledge/internal/02-architecture\.md|scripts/audit-repo-layout(\.test)?\.mjs)$'; then
  echo "🧭 repository layout audit…"
  bun run audit:layout
fi

# Sponsor and funding mirrors are generated from packages/docs/sponsor-registry.json.
if staged '^(packages/docs/(sponsor-registry|community-touchpoints)\.json$|packages/docs/public/|scripts/sync-sponsors(\.test)?\.mjs$|\.github/FUNDING\.yml$|(.+/)?(README\.md|package\.json|pubspec\.yaml)$)'; then
  echo "💛 sponsor surface audit…"
  if ! git diff --quiet -- scripts/sync-sponsors.mjs; then
    echo "❌ sync-sponsors.mjs has unstaged changes; stage it before committing sponsor surfaces."
    exit 1
  fi
  node scripts/sync-sponsors.mjs --staged
fi

if staged '^(packages/kit/convex/(schema|products/(mutation|query|clientPayloads)|purchases/purchaseState)\.ts|packages/kit/server/api/v1/(products|route-response-schemas)\.ts|specs/client/src/type\.graphql|scripts/audit-kit-spec-contract(\.test)?\.mjs)$'; then
  echo "🔎 IAPKit spec contract audit…"
  node --test scripts/audit-kit-spec-contract.test.mjs
  node scripts/audit-kit-spec-contract.mjs
fi

# Both plugin manifests must carry openiap-versions.json's plugin version.
if staged '^(plugins/openiap/|openiap-versions\.json$|scripts/audit-plugin-manifests(\.test)?\.mjs$)'; then
  echo "🧩 plugin manifest audit…"
  bun run audit:plugins
fi

# Codex, Claude, and Grok must stay pointed at the same workflows.
if staged '^(\.claude/|\.codex/|libraries/[^/]+/\.claude/|AGENTS\.md$|CLAUDE\.md$|GEMINI\.md$|knowledge/internal/10-agent-tooling\.md$|scripts/audit-agent-surfaces(\.test)?\.mjs$)'; then
  echo "🤝 agent surface audit…"
  bun run audit:agents
fi

# Unit guards only; OSV-Scanner needs the network and runs in CI.
if staged '(^|/)osv-scanner\.toml$|(^|/)(bun\.lock|yarn\.lock|Gemfile\.lock)$|^scripts/(audit-security|bun-dependency-snapshot)(\.test)?\.mjs$'; then
  echo "🔐 dependency exception guards…"
  node --test scripts/audit-security.test.mjs scripts/bun-dependency-snapshot.test.mjs
fi

# Path filters gate native builds; a filter edit must not silently skip them.
if staged '^(\.github/(workflows|actions)/|scripts/audit-ci-path-filters(\.test)?\.mjs$|scripts/agent/context-files\.ts$)'; then
  echo "🧭 CI path filter audit…"
  bun run audit:ci-paths
fi

# Mirrors deploy-kit.yml's verify job. MCP server and Commerce Protocol ship in
# the kit binary, and kit's conformance test is what catches spec drift.
if staged '^(packages/(kit|mcp-server)|specs/commerce-protocol)/'; then
  echo "🧰 kit-touched commit — running the CI-equivalent gate…"
  bun install --frozen-lockfile
  bun run --filter @hyodotdev/openiap-kit lint
  (
    cd packages/kit \
      && bunx prettier --check \
        "src/**/*.{ts,tsx,css,json}" \
        "server/**/*.ts" \
        "convex/**/*.ts"
  )
  bun run --filter @hyodotdev/openiap-kit test
  bun run --filter @hyodotdev/openiap-commerce-protocol test
  bun run --filter @hyodotdev/openiap-kit smoke:server
  bun run --filter @hyodotdev/openiap-mcp-server lint
  bun run --filter @hyodotdev/openiap-mcp-server test
fi

if staged '^libraries/flutter_inapp_purchase/(lib|test)/'; then
  if command -v flutter >/dev/null 2>&1; then
    echo "🐦 flutter-touched commit — running flutter analyze…"
    (
      # Flutter asks Git for its own SDK version; the hook's Git variables
      # would point it at this repository instead.
      unset $(git rev-parse --local-env-vars)
      cd libraries/flutter_inapp_purchase
      flutter analyze
    )
  else
    echo "⚠️  flutter not on PATH — skipping flutter analyze (CI will catch any issues)."
  fi
fi

# Every specs/client change runs the full schema suite and canonical
# generation, then rejects generated outputs that were not staged.
if node specs/client/scripts/assert-generation-inputs-staged.mjs has-staged-inputs; then
  echo "🧬 gql-touched commit — running tests + canonical generation…"
  node specs/client/scripts/assert-generation-inputs-staged.mjs assert-staged-clean
  bun install --frozen-lockfile
  (
    cd specs/client
    bun run test
    bun run generate
    bun run verify:generated-staged
  )
fi

# Each Android store flavor compiles separately; one debug compile is ambiguous.
if staged '^(libraries/kmp-iap/library/src|specs/client/src/)'; then
  if [ -x libraries/kmp-iap/gradlew ] && java -version >/dev/null 2>&1; then
    echo "🎯 kmp/client-spec-touched commit — running KMP Android flavor compiles…"
    (
      cd libraries/kmp-iap && ./gradlew \
        :library:compilePlayDebugKotlinAndroid \
        :library:compileHorizonDebugKotlinAndroid \
        :library:compileAmazonDebugKotlinAndroid \
        -q
    )
  else
    echo "⚠️  no usable JDK or KMP Gradle wrapper — skipping KMP compile (CI will catch any issues)."
  fi
fi

# Docs and audit-script changes run the docs checks against their own fixtures.
if staged '^(packages/docs/|specs/client/|specs/commerce-protocol/|scripts/audit-docs(\.test)?\.ts$)'; then
  echo "📘 docs/contract/audit-touched commit — running typecheck + audit + format…"
  bun install --frozen-lockfile
  bun run --filter @hyodotdev/openiap-docs typecheck
  bun test "$REPO_ROOT/scripts/audit-docs.test.ts"
  bun run --filter @hyodotdev/openiap-docs showcase:metrics:test
  bun run audit:docs
  (
    cd packages/docs && bunx prettier --check "src/**/*.{ts,tsx,css}"
  )
fi

# Generated agent context must be recompiled and staged with its sources.
if bun scripts/agent/context-files.ts has-staged-inputs; then
  echo "🧠 knowledge/agent-touched commit — compiling generated context…"
  bun scripts/agent/context-files.ts assert-inputs-staged-clean
  (
    cd scripts/agent
    bun install --frozen-lockfile
    bun run compile:ai
  )
  bun scripts/agent/context-files.ts assert-outputs-clean
fi
