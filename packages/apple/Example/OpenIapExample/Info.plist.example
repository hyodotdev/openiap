<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>IAPKIT_API_KEY</key>
	<!-- Use an openiap-kit_pk_ publishable key. Never embed an openiap-kit_sk_ secret key. -->
	<string>openiap-kit_pk_your_publishable_key_here</string>
</dict>
</plist>
