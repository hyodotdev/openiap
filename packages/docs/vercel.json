{
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/docs",
      "destination": "/docs/getting-started",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*).webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/_app.html"
    }
  ]
}
