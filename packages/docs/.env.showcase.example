# Server-only values. Use an isolated development DB and OAuth app locally.
SHOWCASE_ORIGIN=https://www.openiap.dev
SHOWCASE_DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/showcase?sslmode=require
SHOWCASE_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SHOWCASE_GITHUB_CLIENT_ID=REPLACE_WITH_GITHUB_OAUTH_CLIENT_ID
SHOWCASE_GITHUB_CLIENT_SECRET=REPLACE_WITH_GITHUB_OAUTH_CLIENT_SECRET
SHOWCASE_ADMIN_GITHUB_ID=REPLACE_WITH_NUMERIC_GITHUB_ACCOUNT_ID
