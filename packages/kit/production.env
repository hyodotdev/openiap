# Public SSOT for the official IAPKit production Convex deployment.
# CI and the emergency deploy script both verify the Convex CLI's canonical
# target against this URL before publishing a Fly image. The URL is the
# deployment's custom domain, set as its CONVEX_CLOUD_URL override.
IAPKIT_PRODUCTION_CONVEX_DEPLOYMENT=healthy-kudu-836
IAPKIT_PRODUCTION_CONVEX_URL=https://api.openiap.dev
