{
  "name": "@hyodotdev/openiap-client-protocol",
  "version": "1.0.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/generated/types.js",
  "types": "dist/generated/types.d.ts",
  "typesVersions": {
    "*": {
      "kit-api": [
        "./dist/kit-api.d.ts"
      ],
      "purchase-flow": [
        "./dist/purchase-flow.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "openiap-source": "./src/generated/types.ts",
      "types": "./dist/generated/types.d.ts",
      "import": "./dist/generated/types.js",
      "default": "./dist/generated/types.js"
    },
    "./kit-api": {
      "openiap-source": "./src/kit-api.ts",
      "types": "./dist/kit-api.d.ts",
      "import": "./dist/kit-api.js",
      "default": "./dist/kit-api.js"
    },
    "./purchase-flow": {
      "openiap-source": "./src/purchase-flow.ts",
      "types": "./dist/purchase-flow.d.ts",
      "import": "./dist/purchase-flow.js",
      "default": "./dist/purchase-flow.js"
    },
    "./swift": "./src/generated/Types.swift",
    "./kotlin": "./src/generated/Types.kt",
    "./dart": "./src/generated/types.dart",
    "./gdscript": "./src/generated/types.gd",
    "./csharp": "./src/generated/Types.cs"
  },
  "files": [
    "dist/",
    "src/*.graphql",
    "src/kit-api.ts",
    "src/purchase-flow.ts",
    "src/generated/"
  ],
  "scripts": {
    "build:package": "rm -rf dist && tsc -p tsconfig.publish.json",
    "prepack": "bun run build:package",
    "generate": "bun run generate:ts && bun codegen/index.ts && bun scripts/generate-gdscript-runtime-fixture.ts && bun run sync",
    "generate:ts": "graphql-codegen --config codegen.ts && bun scripts/fix-generated-types.mjs",
    "generate:swift": "bun codegen/index.ts swift",
    "generate:kotlin": "bun codegen/index.ts kotlin",
    "generate:dart": "bun codegen/index.ts dart",
    "generate:gdscript": "bun codegen/index.ts gdscript",
    "generate:csharp": "bun codegen/index.ts csharp",
    "sync": "node scripts/sync-to-platforms.mjs",
    "verify:generated-staged": "node scripts/assert-generated-staged.mjs",
    "audit:schema-semver": "node --test scripts/audit-schema-semver.test.mjs && node scripts/audit-schema-semver.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun run typecheck && vitest run src"
  },
  "keywords": [
    "graphql",
    "types",
    "openiap",
    "iap"
  ],
  "author": "hyodotdev",
  "license": "MIT",
  "description": "OpenIAP client GraphQL contract and generated cross-platform types",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyodotdev/openiap.git",
    "directory": "specs/client"
  },
  "homepage": "https://openiap.dev",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/hyodotdev"
    },
    {
      "type": "opencollective",
      "url": "https://opencollective.com/openiap"
    },
    {
      "type": "paypal",
      "url": "https://www.paypal.me/dooboolab"
    }
  ],
  "devDependencies": {
    "@graphql-codegen/add": "^7.1.1",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript": "^6.1.2",
    "@types/bun": "^1.2.0",
    "graphql": "^16.11.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.5"
  },
  "packageManager": "bun@1.3.13"
}
