{
  "compilerOptions": {
    "allowJs": true,
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["bun"]
  },
  "include": ["*.ts", "codegen/**/*.ts", "src/*.ts", "scripts/*.ts"]
}
