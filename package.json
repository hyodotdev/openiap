{
  "name": "openiap-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "OpenIAP - Open In-App Purchase monorepo",
  "workspaces": [
    "packages/*",
    "specs/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "dev": "bun run --filter '*' dev",
    "test": "bun run --filter '*' test",
    "lint": "bun run --filter '*' lint",
    "e2e:web": "node scripts/e2e-web-sites.mjs",
    "audit:deprecations": "node --test scripts/audit-deprecation-schedule.test.mjs && node scripts/audit-deprecation-schedule.mjs",
    "audit:layout": "node --test scripts/audit-repo-layout.test.mjs && node scripts/audit-repo-layout.mjs",
    "audit:overrides": "node --test scripts/audit-npm-overrides.test.mjs && node scripts/audit-npm-overrides.mjs",
    "audit:ci-paths": "node --test scripts/audit-ci-path-filters.test.mjs && node scripts/audit-ci-path-filters.mjs",
    "audit:agents": "node --test scripts/audit-agent-surfaces.test.mjs && node scripts/audit-agent-surfaces.mjs",
    "audit:sponsors": "node --test scripts/sync-sponsors.test.mjs && node scripts/sync-sponsors.mjs",
    "audit:parity": "node scripts/audit-non-godot-parity.mjs",
    "audit:kit-contract": "node --test scripts/audit-kit-spec-contract.test.mjs && node scripts/audit-kit-spec-contract.mjs",
    "audit:docs": "bun run scripts/audit-docs.ts",
    "audit:schema-semver": "bun run --cwd specs/client audit:schema-semver",
    "audit:research": "node --test scripts/audit-research.test.mjs && node scripts/audit-research.mjs",
    "research:mine-issues": "node --test scripts/mine-iap-issues.test.mjs && node scripts/mine-iap-issues.mjs",
    "audit:dependencies": "node scripts/audit-security.mjs dependencies",
    "audit:release-state": "node scripts/release-branch-policy.mjs audit",
    "sbom": "node scripts/generate-sbom.mjs",
    "sbom:test": "node --test scripts/generate-sbom.test.mjs",
    "clean": "rm -rf packages/*/node_modules specs/*/node_modules node_modules",
    "generate": "cd specs/client && bun run generate",
    "version:sync": "bun scripts/sync-versions.mjs",
    "sponsors:sync": "node scripts/sync-sponsors.mjs --write",
    "version:bump": "bun scripts/bump-version.mjs",
    "deploy": "./scripts/deploy.sh",
    "deploy:kit": "cd packages/kit && npx convex deploy",
    "prepare": "husky",
    "audit:release-sync": "node --test scripts/audit-release-sync-script.test.mjs && node scripts/audit-release-sync-script.mjs",
    "audit:facts": "node --test scripts/audit-facts.test.mjs scripts/graph-impact.test.mjs && node scripts/audit-facts.mjs",
    "graph:impact": "node scripts/graph-impact.mjs",
    "audit:sbom-docs": "node --test scripts/audit-sbom-docs.test.mjs && node scripts/audit-sbom-docs.mjs",
    "audit:godot-binaries": "node --test scripts/audit-godot-binary-digests.test.mjs && node scripts/audit-godot-binary-digests.mjs",
    "licenses:inventory": "node scripts/generate-third-party-notices.mjs godot --inventory",
    "audit:horizon-app-id": "node --test scripts/audit-horizon-example-app-id.test.mjs scripts/verify-horizon-merged-manifest.test.mjs && node scripts/audit-horizon-example-app-id.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "husky": "^9.1.7",
    "typescript": "^5.9.2",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "csstype": "3.2.3",
    "fast-uri": "$fast-uri",
    "hono": "4.13.2",
    "ip-address": "10.5.0",
    "qs": "$qs"
  },
  "packageManager": "bun@1.3.13",
  "dependencies": {
    "fast-uri": "^3.1.7",
    "qs": "^6.16.0"
  }
}
