{
  "mcpServers": {
    "openiap": {
      "command": "sh",
      "args": [
        "-c",
        "exec npx -y supergateway --streamableHttp https://kit.openiap.dev/mcp --header \"Authorization: Bearer $IAPKIT_API_KEY\""
      ],
      "env": {
        "IAPKIT_API_KEY": "${IAPKIT_API_KEY:-}"
      }
    }
  }
}
