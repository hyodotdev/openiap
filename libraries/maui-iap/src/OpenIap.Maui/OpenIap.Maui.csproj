<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <!-- UseMaui only activates on platform TFMs (android/ios/maccatalyst).
         The shared `net10.0` build is contract-only — IOpenIap, generated
         Types, factory dispatch — and references no MAUI Controls types,
         so it doesn't need the MAUI workload at restore/build time.
         Keeping UseMaui unconditional makes the shared TFM require
         `maui-android` (and the multi-target restore also walks into
         Bindings.iOS, requiring iOS workload packs) — which defeats the
         purpose of having a workload-free fast lane in CI. -->
    <UseMaui Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != ''">true</UseMaui>
    <!-- Library — compile against the current MAUI servicing release without
         leaking a hard Maui.Controls dependency into the public NuGet graph. -->
    <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
    <!-- SingleProject auto-includes only the matching Platforms/<TFM>/ folder.
         We need iOS sources to also compile under macCatalyst, so opt out and
         manage Compile globs ourselves below. -->
    <SingleProject>false</SingleProject>
    <EnableDefaultMauiItems>false</EnableDefaultMauiItems>
    <RootNamespace>OpenIap.Maui</RootNamespace>
    <AssemblyName>OpenIap.Maui</AssemblyName>
    <PackageId>OpenIap.Maui</PackageId>
    <PackageVersion>2.5.0</PackageVersion>
    <Title>OpenIAP for .NET MAUI</Title>
    <Description>OpenIAP — unified in-app purchases for .NET MAUI (iOS / Android). Mirrors the OpenIAP GraphQL schema and shares the same API surface as react-native-iap, expo-iap, flutter_inapp_purchase, and kmp-iap.</Description>
    <Authors>hyodotdev</Authors>
    <RepositoryUrl>https://github.com/hyodotdev/openiap</RepositoryUrl>
    <PackageProjectUrl>https://openiap.dev</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>iap;in-app-purchase;maui;dotnet;android;ios;openiap</PackageTags>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591;CS1573</NoWarn>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Hide platform-specific source from non-platform builds so the .NET-only
         contract (interfaces + types) compiles cleanly without referencing
         StoreKit / BillingClient APIs. -->
    <Compile Remove="Platforms/**/*.cs" />
    <None Include="Platforms/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <Compile Include="Platforms/Android/**/*.cs" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiControlsVersion)" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <!-- iOS resolver compiles for macCatalyst too — same xcframework, same StoreKit surface. -->
    <Compile Include="Platforms/iOS/**/*.cs" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiControlsVersion)" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <Compile Include="Platforms/MacCatalyst/**/*.cs" />
  </ItemGroup>

  <!-- Native bindings: wire each per its supported TFMs. PrivateAssets=all keeps
       the binding projects out of the generated nuspec dependencies; this package
       intentionally ships as the single public NuGet ID, OpenIap.Maui. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <ProjectReference Include="..\OpenIap.Maui.Bindings.Android\OpenIap.Maui.Bindings.Android.csproj" PrivateAssets="all" OutputItemType="Reference" />
    <!-- Billing's runtime dependencies. Billing itself comes from Maven in a Play
         build only (buildTransitive/OpenIap.Maui.targets): its NuGet binding
         would link it into every store. These stay NuGet so an app shares them
         with Firebase, and NuGet cannot vary them per store. -->
    <PackageReference Include="Xamarin.GooglePlayServices.Base" Version="$(MauiPlayServicesBaseVersion)" />
    <PackageReference Include="Xamarin.GooglePlayServices.Basement" Version="$(MauiPlayServicesBasementVersion)" />
    <PackageReference Include="Xamarin.GooglePlayServices.Location" Version="$(MauiPlayServicesLocationVersion)" />
    <PackageReference Include="Xamarin.GooglePlayServices.Tasks" Version="$(MauiPlayServicesTasksVersion)" />
    <PackageReference Include="Xamarin.Google.Android.DataTransport.TransportApi" Version="$(MauiDataTransportVersion)" />
    <PackageReference Include="Xamarin.Google.Android.DataTransport.TransportBackendCct" Version="$(MauiDataTransportVersion)" />
    <PackageReference Include="Xamarin.Google.Android.DataTransport.TransportRuntime" Version="$(MauiDataTransportVersion)" />
    <!-- Horizon's SDK reads kotlinx.serialization, and NuGet cannot add it per build. -->
    <PackageReference Include="Xamarin.KotlinX.Serialization.Json" Version="$(MauiHorizonSerializationNuGetVersion)" />
    <PackageReference Include="Xamarin.KotlinX.Serialization.Json.Jvm" Version="$(MauiHorizonSerializationNuGetVersion)" />
    <PackageReference Include="GoogleGson" Version="$(MauiGoogleGsonNuGetVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Activity" Version="$(MauiAndroidXActivityVersion)" />
    <!-- MAUI Navigation still brings older KTX compatibility packages with
         strict upper bounds. Pin the current bindings so NuGet resolves the
         compatibility artifacts alongside their base AndroidX packages. The
         OpenIAP implementation itself uses the merged base APIs. -->
    <PackageReference Include="Xamarin.AndroidX.Activity.Ktx" Version="$(MauiAndroidXActivityVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="$(MauiAndroidXCollectionVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Fragment" Version="$(MauiAndroidXFragmentVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="$(MauiAndroidXFragmentKtxVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="$(MauiAndroidXLifecycleVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core" Version="$(MauiAndroidXLifecycleVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="$(MauiAndroidXLifecycleVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="$(MauiAndroidXLifecycleVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime" Version="$(MauiAndroidXLifecycleVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="$(MauiAndroidXLifecycleVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx.Android" Version="$(MauiAndroidXLifecycleVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel" Version="$(MauiAndroidXLifecycleVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" Version="$(MauiAndroidXLifecycleVersion)" />
    <PackageReference Include="Xamarin.AndroidX.SavedState" Version="$(MauiAndroidXSavedStateVersion)" />
    <PackageReference Include="Xamarin.AndroidX.SavedState.SavedState.Ktx" Version="$(MauiAndroidXSavedStateVersion)" />
    <PackageReference Include="Xamarin.Kotlin.StdLib" Version="$(MauiKotlinStdLibVersion)" />
    <PackageReference Include="Xamarin.KotlinX.Coroutines.Core" Version="$(MauiKotlinCoroutinesVersion)" />
    <PackageReference Include="Xamarin.KotlinX.Coroutines.Core.Jvm" Version="$(MauiKotlinCoroutinesVersion)" />
    <PackageReference Include="Xamarin.KotlinX.Coroutines.Android" Version="$(MauiKotlinCoroutinesVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <ProjectReference Include="..\OpenIap.Maui.Bindings.iOS\OpenIap.Maui.Bindings.iOS.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- Every store's openiap-google build ships outside lib/, where .NET would
       link all of them; the app's build picks one. -->
  <PropertyGroup>
    <_OpenIapGoogleAarOutputs>..\..\..\..\packages\google\openiap\build\outputs\aar\</_OpenIapGoogleAarOutputs>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(_OpenIapGoogleAarOutputs)openiap-play-release.aar;$(_OpenIapGoogleAarOutputs)openiap-horizon-release.aar;$(_OpenIapGoogleAarOutputs)openiap-amazon-release.aar" Pack="true" PackagePath="android" Visible="false" />
    <None Include="buildTransitive\OpenIap.Maui.props;buildTransitive\OpenIap.Maui.targets" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>
  <Target Name="_OpenIapRequireStoreAars" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(_OpenIapGoogleAarOutputs)openiap-play-release.aar') or !Exists('$(_OpenIapGoogleAarOutputs)openiap-horizon-release.aar') or !Exists('$(_OpenIapGoogleAarOutputs)openiap-amazon-release.aar')"
           Text="Build all three openiap-google release AARs before packing (packages/google: ./gradlew :openiap:assemblePlayRelease :openiap:assembleHorizonRelease :openiap:assembleAmazonRelease)." />
    <!-- IncludeBindingsInNuPkg skips a missing facade, which would only show as a
         NoClassDefFoundError in the app. -->
    <Error Condition="!Exists('..\..\android\openiap\build\outputs\aar\openiap-release.aar')"
           Text="Build the MAUI facade AAR before packing (libraries/maui-iap/android: ../../../packages/google/gradlew :openiap:assembleRelease)." />
  </Target>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <!-- Unit-test access to shared internals (OpenIapErrorMapper, JsonOptions,
         Subject) — see tests/OpenIap.Maui.Tests. -->
    <InternalsVisibleTo Include="OpenIap.Maui.Tests" />
  </ItemGroup>

  <!-- Ship only OpenIAP-owned Android AARs alongside OpenIap.Maui.dll.
       Play Services, AndroidX, Gson, and Kotlin runtime libraries are
       PackageReference dependencies so consumer apps can deduplicate them
       with their own Xamarin.* package graph. -->
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeBindingsInNuPkg</TargetsForTfmSpecificBuildOutput>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.aar;.zip</AllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>

  <Target Name="IncludeBindingsInNuPkg" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Filename)' == 'OpenIap.Maui.Bindings.Android' or '%(ReferenceCopyLocalPaths.Filename)' == 'OpenIap.Maui.Bindings.iOS'" />
      <BuildOutputInPackage Include="..\..\android\openiap\build\outputs\aar\openiap-release.aar" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and Exists('..\..\android\openiap\build\outputs\aar\openiap-release.aar')" />
      <BuildOutputInPackage Include="$(OutputPath)OpenIap.Maui.Bindings.iOS.resources.zip" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'" />
    </ItemGroup>
  </Target>

</Project>
