<Project>
  <UsingTask TaskName="OpenIapReadProviderArtifacts" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ManifestFile ParameterType="System.String" Required="true" />
      <Libraries ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
      <Redirects ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        Libraries = System.IO.File.ReadAllLines(ManifestFile).Select(line => {
          var fields = line.Split('\t');
          if (fields.Length != 2) throw new System.InvalidOperationException("Invalid provider artifact manifest");
          var item = new Microsoft.Build.Utilities.TaskItem(fields[0]);
          item.SetMetadata("JavaArtifact", fields[1]);
          item.SetMetadata("Bind", "false");
          return (Microsoft.Build.Framework.ITaskItem)item;
        }).ToArray();
        Redirects = System.IO.File.ReadAllLines(ManifestFile + ".redirects")
          .Select(line => (Microsoft.Build.Framework.ITaskItem)new Microsoft.Build.Utilities.TaskItem(line)).ToArray();
      ]]></Code>
    </Task>
  </UsingTask>

  <!--
    Links one Android store into an app, by the rule every OpenIAP build shares:
    OpenIapStore (the deprecated OpenIapAndroidStore still pins, and must agree
    with it), then on a Debug build the adb device AdbTarget or ANDROID_SERIAL
    names, or the single attached one, then Play. NuGet dependencies are fixed
    at restore, so what any store needs from NuGet (Play Services for Billing,
    kotlinx.serialization for Horizon) is in every build; only the store's own
    AAR and SDKs are chosen here.
  -->
  <!-- NuGet imports the props itself; a project reference imports only this file. -->
  <Import Project="$(MSBuildThisFileDirectory)OpenIap.Maui.props" Condition="'$(_OpenIapMauiPropsImported)' != 'true'" />

  <PropertyGroup>
    <OpenIapGoogleAarDirectory Condition="'$(OpenIapGoogleAarDirectory)' == ''">$(MSBuildThisFileDirectory)..\android\</OpenIapGoogleAarDirectory>
    <OpenIapCoreAarDirectory Condition="'$(OpenIapCoreAarDirectory)' == ''">$(MSBuildThisFileDirectory)..\android\</OpenIapCoreAarDirectory>
  </PropertyGroup>

  <Target Name="_OpenIapResolveStorePin">
    <ItemGroup>
      <!-- The values both store properties accept, as in openiap-store.gradle. -->
      <_OpenIapStoreName Include="auto" Store="auto" />
      <_OpenIapStoreName Include="play;google;gplay;googleplay;google-play;gms" Store="play" />
      <_OpenIapStoreName Include="horizon;meta;quest" Store="horizon" />
      <_OpenIapStoreName Include="amazon;fire;fireos;fire-os" Store="amazon" />
    </ItemGroup>
    <PropertyGroup>
      <_OpenIapPinValue>$([MSBuild]::ValueOrDefault('$(OpenIapStore.Trim())', 'auto'))</_OpenIapPinValue>
      <_OpenIapAliasValue>$([MSBuild]::ValueOrDefault('$(OpenIapAndroidStore.Trim())', 'auto'))</_OpenIapAliasValue>
      <_OpenIapPinStore>@(_OpenIapStoreName->WithMetadataValue('Identity', '$(_OpenIapPinValue)')->Metadata('Store'))</_OpenIapPinStore>
      <_OpenIapAliasStore>@(_OpenIapStoreName->WithMetadataValue('Identity', '$(_OpenIapAliasValue)')->Metadata('Store'))</_OpenIapAliasStore>
      <_OpenIapCommunity Condition="'$(_OpenIapPinStore)' != 'auto' and '$(_OpenIapPinStore)' != 'play' and '$(_OpenIapPinStore)' != 'horizon' and '$(_OpenIapPinStore)' != 'amazon' and '$(OpenIapProvider.Trim())' != '' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(_OpenIapPinValue)', '^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$')) and '$(_OpenIapPinValue)' != 'apple' and '$(_OpenIapPinValue)' != 'none' and '$(_OpenIapPinValue)' != 'unknown'">true</_OpenIapCommunity>
      <_OpenIapPinStore Condition="'$(_OpenIapCommunity)' == 'true' and '$(_OpenIapPinStore)' == ''">$(_OpenIapPinValue)</_OpenIapPinStore>
      <_OpenIapUnknownStore Condition="'$(_OpenIapAliasStore)' == ''">OpenIapAndroidStore='$(OpenIapAndroidStore)'</_OpenIapUnknownStore>
      <_OpenIapUnknownStore Condition="'$(_OpenIapPinStore)' == ''">OpenIapStore='$(OpenIapStore)'</_OpenIapUnknownStore>
    </PropertyGroup>
    <Error Condition="'$(_OpenIapUnknownStore)' != ''"
           Text="$(_OpenIapUnknownStore) is not a store. Use play, horizon, amazon, or auto (aliases: google/gplay/googleplay/google-play/gms, meta/quest, fire/fireos/fire-os). Community stores require OpenIapStore and fixed OpenIapProvider coordinates." />
    <Error Condition="'$(OpenIapProvider.Trim())' != '' and '$(_OpenIapCommunity)' != 'true'"
           Text="openiap: OpenIapProvider requires a community OpenIapStore id." />
    <Error Condition="'$(_OpenIapCommunity)' == 'true' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(OpenIapProvider.Trim())', '^[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+:[0-9][A-Za-z0-9_.-]*$'))"
           Text="openiap: OpenIapProvider must be fixed group:artifact:version coordinates." />
    <Error Condition="'$(_OpenIapCommunity)' == 'true' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(OpenIapProvider.Trim())', '^io[.]github[.]hyochan[.]openiap:openiap-'))"
           Text="openiap: OpenIapProvider must name a community artifact." />
    <Warning Condition="'$(OpenIapAndroidStore.Trim())' != '' and '$(DesignTimeBuild)' != 'true'"
             Code="OPENIAP0001"
             Text="openiap: OpenIapAndroidStore is deprecated and will be removed in the next major release; use OpenIapStore=$(_OpenIapAliasStore)" />
    <!-- auto is no pin, as in Gradle: it conflicts with nothing and defers to the alias. -->
    <Error Condition="'$(_OpenIapPinStore)' != 'auto' and '$(_OpenIapAliasStore)' != 'auto' and '$(_OpenIapPinStore)' != '$(_OpenIapAliasStore)' and '$(DesignTimeBuild)' != 'true'"
           Text="openiap: OpenIapStore=$(OpenIapStore.Trim()) conflicts with OpenIapAndroidStore=$(OpenIapAndroidStore.Trim())" />
    <PropertyGroup>
      <OpenIapStorePin>$(_OpenIapPinStore)</OpenIapStorePin>
      <_OpenIapPinReason>OpenIapStore=$(OpenIapStore.Trim())</_OpenIapPinReason>
      <OpenIapStorePin Condition="'$(_OpenIapPinStore)' == 'auto'">$(_OpenIapAliasStore)</OpenIapStorePin>
      <_OpenIapPinReason Condition="'$(_OpenIapPinStore)' == 'auto'">OpenIapAndroidStore=$(OpenIapAndroidStore.Trim())</_OpenIapPinReason>
    </PropertyGroup>
  </Target>

  <!-- A release build never looks at a device, so its SDK cannot depend on what is plugged in. -->
  <Target Name="_OpenIapProbeAndroidDevice"
          DependsOnTargets="_ResolveMonoAndroidSdks"
          Condition="'$(AndroidApplication)' == 'true' and '$(OpenIapStorePin)' == 'auto' and '$(Configuration)' == 'Debug' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_OpenIapAdbExe>$(AdbToolExe)</_OpenIapAdbExe>
      <_OpenIapAdbExe Condition="'$(_OpenIapAdbExe)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">adb.exe</_OpenIapAdbExe>
      <_OpenIapAdbExe Condition="'$(_OpenIapAdbExe)' == ''">adb</_OpenIapAdbExe>
      <_OpenIapAdbDir>$(AdbToolPath)</_OpenIapAdbDir>
      <_OpenIapAdbDir Condition="'$(_OpenIapAdbDir)' == '' and '$(_AndroidSdkDirectory)' != ''">$([System.IO.Path]::Combine('$(_AndroidSdkDirectory)', 'platform-tools'))</_OpenIapAdbDir>
      <_OpenIapAdb>$([System.IO.Path]::Combine('$(_OpenIapAdbDir)', '$(_OpenIapAdbExe)'))</_OpenIapAdb>
      <!-- The IDE's deploy target first, then the variable every Android tool reads. -->
      <_OpenIapRequestedSerial>$(ANDROID_SERIAL.Trim())</_OpenIapRequestedSerial>
      <_OpenIapRequestedSerial Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(AdbTarget)', '-s\s+\S+'))">$([System.Text.RegularExpressions.Regex]::Replace('$(AdbTarget)', '^.*-s\s+(\S+).*$', '$1'))</_OpenIapRequestedSerial>
    </PropertyGroup>

    <Exec Command="&quot;$(_OpenIapAdb)&quot; devices" ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" EchoOff="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="_OpenIapAdbLine" />
    </Exec>
    <ItemGroup>
      <_OpenIapAdbDevice Include="$([System.Text.RegularExpressions.Regex]::Replace('%(_OpenIapAdbLine.Identity)', '\s+device\s*$', ''))"
                         Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(_OpenIapAdbLine.Identity)', '^\S+\s+device\s*$'))" />
    </ItemGroup>
    <PropertyGroup>
      <_OpenIapAdbText>@(_OpenIapAdbLine)</_OpenIapAdbText>
      <!-- adb always prints this header, so without it adb itself failed. -->
      <_OpenIapAdbAnswered Condition="$(_OpenIapAdbText.Contains('List of devices attached'))">true</_OpenIapAdbAnswered>
      <_OpenIapDevices>;@(_OpenIapAdbDevice);</_OpenIapDevices>
      <_OpenIapSerial Condition="'$(_OpenIapRequestedSerial)' != '' and $(_OpenIapDevices.Contains(';$(_OpenIapRequestedSerial);'))">$(_OpenIapRequestedSerial)</_OpenIapSerial>
      <_OpenIapSerial Condition="'$(_OpenIapRequestedSerial)' == '' and '@(_OpenIapAdbDevice->Count())' == '1'">@(_OpenIapAdbDevice)</_OpenIapSerial>
      <_OpenIapProbeReason Condition="'$(_OpenIapAdbAnswered)' != 'true'">adb did not answer</_OpenIapProbeReason>
      <_OpenIapProbeReason Condition="'$(_OpenIapAdbAnswered)' == 'true' and '$(_OpenIapSerial)' == ''">no single connected device</_OpenIapProbeReason>
    </PropertyGroup>
    <Message Importance="high"
             Condition="'$(_OpenIapAdbAnswered)' == 'true' and '$(_OpenIapRequestedSerial)' != '' and '$(_OpenIapSerial)' == ''"
             Text="openiap: $(_OpenIapRequestedSerial) is not attached; not selecting a store from a device" />

    <Exec Condition="'$(_OpenIapSerial)' != ''" Command="&quot;$(_OpenIapAdb)&quot; -s &quot;$(_OpenIapSerial)&quot; shell pm list features" ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" EchoOff="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_OpenIapFeatures" />
    </Exec>
    <Exec Condition="'$(_OpenIapSerial)' != ''" Command="&quot;$(_OpenIapAdb)&quot; -s &quot;$(_OpenIapSerial)&quot; shell getprop ro.product.manufacturer" ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" EchoOff="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_OpenIapManufacturer" />
    </Exec>
    <PropertyGroup Condition="'$(_OpenIapSerial)' != ''">
      <_OpenIapManufacturer>$(_OpenIapManufacturer.Trim())</_OpenIapManufacturer>
      <!-- A device that drops after the listing answers with nothing, which is not a Play signal. -->
      <_OpenIapProbeReason Condition="'$(_OpenIapFeatures.Trim())' == '' and '$(_OpenIapManufacturer)' == ''">$(_OpenIapSerial) stopped responding</_OpenIapProbeReason>
      <_OpenIapDeviceStore Condition="'$(_OpenIapProbeReason)' == ''">play</_OpenIapDeviceStore>
      <_OpenIapDeviceStore Condition="'$(_OpenIapDeviceStore)' == 'play' and ($(_OpenIapFeatures.Contains('feature:amazon.hardware.fire_tv')) or '$(_OpenIapManufacturer.ToLowerInvariant())' == 'amazon')">amazon</_OpenIapDeviceStore>
      <_OpenIapDeviceStore Condition="'$(_OpenIapDeviceStore)' != '' and ($(_OpenIapFeatures.Contains('feature:horizonos.software.horizon_os')) or $(_OpenIapFeatures.Contains('feature:oculus.hardware.standalone_vr')))">horizon</_OpenIapDeviceStore>
      <_OpenIapManufacturer Condition="'$(_OpenIapManufacturer)' == ''">unknown</_OpenIapManufacturer>
      <_OpenIapProbeReason Condition="'$(_OpenIapDeviceStore)' != ''">device $(_OpenIapSerial), manufacturer $(_OpenIapManufacturer)</_OpenIapProbeReason>
    </PropertyGroup>
  </Target>

  <Target Name="_OpenIapLinkAndroidStore"
          DependsOnTargets="_OpenIapResolveStorePin;_OpenIapProbeAndroidDevice"
          BeforeTargets="_CreatePropertiesCache;_MavenRestore;_CategorizeAndroidLibraries"
          Condition="'$(AndroidApplication)' == 'true'">
    <PropertyGroup>
      <OpenIapLinkedStore>$(OpenIapStorePin)</OpenIapLinkedStore>
      <_OpenIapSource>explicit</_OpenIapSource>
      <_OpenIapReason>$(_OpenIapPinReason)</_OpenIapReason>
    </PropertyGroup>
    <PropertyGroup Condition="'$(OpenIapStorePin)' == 'auto'">
      <OpenIapLinkedStore>play</OpenIapLinkedStore>
      <_OpenIapSource>default</_OpenIapSource>
      <_OpenIapReason>$(Configuration) build</_OpenIapReason>
      <_OpenIapReason Condition="'$(_OpenIapProbeReason)' != ''">$(_OpenIapProbeReason)</_OpenIapReason>
      <OpenIapLinkedStore Condition="'$(_OpenIapDeviceStore)' != ''">$(_OpenIapDeviceStore)</OpenIapLinkedStore>
      <_OpenIapSource Condition="'$(_OpenIapDeviceStore)' != ''">device</_OpenIapSource>
    </PropertyGroup>
    <PropertyGroup>
      <_OpenIapGoogleAar Condition="'$(_OpenIapCommunity)' != 'true'">$([System.IO.Path]::GetFullPath('$(OpenIapGoogleAarDirectory)openiap-$(OpenIapLinkedStore)-release.aar'))</_OpenIapGoogleAar>
    </PropertyGroup>
    <PropertyGroup>
      <_OpenIapCoreAar>$([System.IO.Path]::GetFullPath('$(OpenIapCoreAarDirectory)openiap-core-release.aar'))</_OpenIapCoreAar>
    </PropertyGroup>
    <Error Condition="!Exists('$(_OpenIapCoreAar)')" Text="openiap: $(_OpenIapCoreAar) is missing." />
    <Message Importance="high" Text="openiap: store=$(OpenIapLinkedStore) (source=$(_OpenIapSource); $(_OpenIapReason))" />
    <Error Condition="'$(_OpenIapCommunity)' != 'true' and !Exists('$(_OpenIapGoogleAar)')" Text="openiap: $(_OpenIapGoogleAar) is missing, so the $(OpenIapLinkedStore) store cannot be linked." />

    <ItemGroup>
      <AndroidLibrary Include="$(_OpenIapCoreAar)" Bind="false" JavaArtifact="io.github.hyochan.openiap:openiap-core:$(MauiOpenIapCoreVersion)" />
      <AndroidLibrary Include="$(_OpenIapGoogleAar)" Bind="false" Condition="'$(_OpenIapCommunity)' != 'true'" />

      <!-- MSBuild compares timestamps, and another store's AARs can be older than
           the last build, so a changed store must rewrite the properties cache. -->
      <_PropertyCacheItems Include="OpenIapLinkedStore=$(OpenIapLinkedStore)" />
      <_PropertyCacheItems Include="OpenIapProvider=$(OpenIapProvider)" />
    </ItemGroup>
    <ItemGroup Condition="'$(OpenIapLinkedStore)' == 'play'">
      <AndroidMavenLibrary Include="com.android.billingclient:billing" Version="$(MauiPlayBillingVersion)" Repository="Google" Bind="false" />
      <!-- billing:9.1.0's POM dependencies. The package's own NuGet dependencies
           provide them, but the verifier only credits an app's direct references.
           When MauiPlayBillingVersion in OpenIap.Maui.props moves, re-pin this
           list from the new billing POM by hand. -->
      <AndroidIgnoredJavaDependency Include="androidx.activity:activity:1.2.3;androidx.core:core:1.15.0;com.google.android.datatransport:transport-api:3.0.0;com.google.android.datatransport:transport-backend-cct:3.1.8;com.google.android.datatransport:transport-runtime:3.1.8;com.google.android.gms:play-services-base:18.5.0;com.google.android.gms:play-services-basement:18.9.0;com.google.android.gms:play-services-location:19.0.0;com.google.android.gms:play-services-tasks:18.2.0" />
    </ItemGroup>
    <ItemGroup Condition="'$(OpenIapLinkedStore)' == 'horizon'">
      <AndroidMavenLibrary Include="com.meta.horizon.billingclient.api:horizon-billing-compatibility" Version="$(MauiHorizonBillingCompatibilityVersion)" Bind="false" />
      <AndroidMavenLibrary Include="com.meta.horizon.platform.sdk:core-kotlin" Version="$(MauiHorizonPlatformKotlinVersion)" Bind="false" />
      <AndroidMavenLibrary Include="com.meta.horizon.platform.sdk:user-age-category-kotlin" Version="$(MauiHorizonPlatformKotlinVersion)" Bind="false" />
      <AndroidMavenLibrary Include="com.meta.horizon.platform.sdk:iap-kotlin" Version="$(MauiHorizonPlatformKotlinVersion)" Bind="false" />
      <!-- Supplied by the package's Xamarin.KotlinX.Serialization.Json dependency. -->
      <AndroidIgnoredJavaDependency Include="org.jetbrains.kotlinx:kotlinx-serialization-json:1.7.3" />
    </ItemGroup>
    <ItemGroup Condition="'$(OpenIapLinkedStore)' == 'amazon'">
      <AndroidMavenLibrary Include="com.amazon.device:amazon-appstore-sdk" Version="$(MauiAmazonAppstoreSdkVersion)" Bind="false" />
    </ItemGroup>
  </Target>

  <Target Name="_OpenIapResolveCommunityDependencies"
          DependsOnTargets="_OpenIapLinkAndroidStore;ResolvePackageAssets;_ResolveSdks"
          BeforeTargets="_MavenRestore;_VerifyJavaDependencies;_CategorizeAndroidLibraries"
          Condition="'$(AndroidApplication)' == 'true'">
    <PropertyGroup Condition="'$(_OpenIapCommunity)' == 'true'">
      <_OpenIapResolverDirectory>$(MSBuildThisFileDirectory)provider-resolver</_OpenIapResolverDirectory>
      <_OpenIapWrapperJar>$(_OpenIapResolverDirectory)/gradle/wrapper/gradle-wrapper.jar</_OpenIapWrapperJar>
      <_OpenIapWrapperJar Condition="!Exists('$(_OpenIapWrapperJar)')">$(MSBuildThisFileDirectory)../../../../../packages/google/gradle/wrapper/gradle-wrapper.jar</_OpenIapWrapperJar>
      <_OpenIapResolverOutput>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)openiap-provider'))</_OpenIapResolverOutput>
      <_OpenIapResolverManifest>$(_OpenIapResolverOutput)/artifacts.tsv</_OpenIapResolverManifest>
      <_OpenIapJavaExe>$(_JavaSdkDirectory)/bin/java</_OpenIapJavaExe>
      <_OpenIapJavaExe Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(_OpenIapJavaExe).exe</_OpenIapJavaExe>
    </PropertyGroup>
    <ItemGroup Condition="'$(_OpenIapCommunity)' == 'true'">
      <_OpenIapSuppliedJava Include="@(AndroidLibrary->'%(JavaArtifact)');@(PackageReference->'%(JavaArtifact)');@(ProjectReference->'%(JavaArtifact)');@(AndroidIgnoredJavaDependency)" />
      <_OpenIapSuppliedJava Include="@(AndroidMavenLibrary->'%(Identity):%(Version)')" Condition="'%(AndroidMavenLibrary.JavaArtifact)' == ''" />
      <_OpenIapSuppliedJava Include="@(AndroidMavenLibrary->'%(JavaArtifact)')" Condition="'%(AndroidMavenLibrary.JavaArtifact)' != ''" />
    </ItemGroup>
    <MakeDir Condition="'$(_OpenIapCommunity)' == 'true'" Directories="$(_OpenIapResolverOutput)" />
    <WriteLinesToFile Condition="'$(_OpenIapCommunity)' == 'true'" File="$(_OpenIapResolverOutput)/supplied.txt" Lines="@(_OpenIapSuppliedJava)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile Condition="'$(_OpenIapCommunity)' == 'true'" File="$(_OpenIapResolverOutput)/repositories.txt" Lines="@(OpenIapProviderRepository)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <Exec Condition="'$(_OpenIapCommunity)' == 'true'" Command="&quot;$(_OpenIapJavaExe)&quot; -classpath &quot;$(_OpenIapWrapperJar)&quot; org.gradle.wrapper.GradleWrapperMain -p &quot;$(_OpenIapResolverDirectory)&quot; resolveProvider --no-daemon --console=plain --project-cache-dir &quot;$(_OpenIapResolverOutput)/gradle-cache&quot;"
          EnvironmentVariables="OPENIAP_SUPPLIED=$(_OpenIapResolverOutput)/supplied.txt;OPENIAP_ASSETS=$(ProjectAssetsFile);OPENIAP_TARGET=$(TargetFramework);OPENIAP_PROVIDER=$(OpenIapProvider);OPENIAP_REPOSITORIES_FILE=$(_OpenIapResolverOutput)/repositories.txt;OPENIAP_OUTPUT=$(_OpenIapResolverManifest);JAVA_HOME=$(_JavaSdkDirectory)" />
    <OpenIapReadProviderArtifacts Condition="'$(_OpenIapCommunity)' == 'true'" ManifestFile="$(_OpenIapResolverManifest)">
      <Output TaskParameter="Libraries" ItemName="AndroidLibrary" />
      <Output TaskParameter="Redirects" ItemName="AndroidIgnoredJavaDependency" />
    </OpenIapReadProviderArtifacts>
  </Target>
</Project>
