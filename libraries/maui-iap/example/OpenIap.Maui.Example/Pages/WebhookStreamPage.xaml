<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OpenIap.Maui.Example.Pages.WebhookStreamPage"
             Title="Webhook Stream"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="Trusted backend or MCP only"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#111827" />

            <Border Stroke="#FDBA74"
                    StrokeShape="RoundRectangle 12"
                    Padding="16"
                    BackgroundColor="#FFF7ED">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Do not connect from a shipped app"
                           FontAttributes="Bold"
                           TextColor="#9A3412" />
                    <Label Text="The project-wide IAPKit stream contains lifecycle records and purchase identifiers. It requires an openiap-kit_sk_ secret admin key, which must never be embedded in a MAUI app."
                           TextColor="#374151" />
                </VerticalStackLayout>
            </Border>

            <Border Stroke="#E5E7EB"
                    StrokeShape="RoundRectangle 12"
                    Padding="16"
                    BackgroundColor="#F9FAFB">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Mobile app" FontAttributes="Bold" TextColor="#111827" />
                    <Label Text="Use an openiap-kit_pk_ publishable key for purchase verification, user-scoped entitlement helpers, and public product payloads."
                           TextColor="#374151" />
                </VerticalStackLayout>
            </Border>

            <Border Stroke="#E5E7EB"
                    StrokeShape="RoundRectangle 12"
                    Padding="16"
                    BackgroundColor="#F9FAFB">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Trusted consumer" FontAttributes="Bold" TextColor="#111827" />
                    <Label Text="MCP, CI, or your backend connects to GET /v1/webhooks/stream and sends Authorization: Bearer &lt;IAPKIT_SECRET_KEY&gt;. If your backend protects paid content, it should make the final entitlement decision."
                           TextColor="#374151" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Configure the separate lifecycle webhook URL from the IAPKit dashboard in App Store Connect and Google Cloud Pub/Sub."
                   TextColor="#6B7280" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
