<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OpenIap.Maui.Example.Pages.AppOwnershipPage"
             Title="App Ownership"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <VerticalStackLayout Spacing="6">
                <Label Text="App Ownership"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#1A1A1A" />
                <Label Text="Check the app came from its store"
                       FontSize="14"
                       TextColor="#5F6470" />
            </VerticalStackLayout>

            <Border Stroke="#E1E7EF" StrokeShape="RoundRectangle 12" Padding="14" BackgroundColor="#F7F9FC">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Google Play requires a linked Cloud project number and a request hash from your backend. Unknown is inconclusive; send evidence to your backend for verification."
                           FontSize="12" TextColor="#5F6470" />
                    <Entry x:Name="CloudProjectNumberEntry" Placeholder="Google Cloud project number"
                           IsTextPredictionEnabled="False" IsSpellCheckEnabled="False" />
                    <Entry x:Name="RequestHashEntry" Placeholder="Request hash"
                           IsTextPredictionEnabled="False" IsSpellCheckEnabled="False" />
                    <Button x:Name="CheckButton" Text="Check app ownership"
                            BackgroundColor="#1A1A1A" TextColor="White" CornerRadius="8"
                            HorizontalOptions="Start" Padding="14,8" Clicked="OnCheckClicked" />
                    <Label x:Name="ResultLabel" IsVisible="False" TextColor="#1A1A1A" FontSize="12" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
