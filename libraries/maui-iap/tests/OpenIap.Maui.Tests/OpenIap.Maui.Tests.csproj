<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Shared-contract tests only — net10.0 keeps this project buildable without
         any MAUI / mobile workload. Run with the same global override CI uses
         for every shared-TFM lane in this library:
           dotnet test tests/OpenIap.Maui.Tests/OpenIap.Maui.Tests.csproj -p:TargetFrameworks=net10.0
         The PLURAL TargetFrameworks property must be passed so the implicit
         restore of the referenced OpenIap.Maui.csproj does not walk its
         android / ios TFMs (see the comment in ci-maui-iap.yml). -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OpenIap.Maui/OpenIap.Maui.csproj" />
  </ItemGroup>

</Project>
