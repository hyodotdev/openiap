// Secrets configuration example
// Copy this file to Secrets.xcconfig and add your API keys

// IAPKit publishable key for mobile purchase verification.
// Get an openiap-kit_pk_ key from https://kit.openiap.dev.
// Never put an openiap-kit_sk_ secret admin key in an app build.
IAPKIT_API_KEY=openiap-kit_pk_your_publishable_key_here

// Origin of a local IAPKit server for Local (IAPKit); empty uses kit.openiap.dev.
// A physical iPhone needs the Mac's LAN address, not loopback. `//` starts a
// comment in xcconfig, so write the scheme as http:/$()/ to keep it literal.
IAPKIT_BASE_URL=

// true only for Amazon App Tester receipts, which verify against the RVS sandbox.
AMAZON_RVS_SANDBOX=false
