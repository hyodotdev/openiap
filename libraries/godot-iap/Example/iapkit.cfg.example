; Copy to iapkit.cfg (untracked) and fill in.
[iapkit]
; openiap-kit_pk_ publishable key; never an openiap-kit_sk_ admin key.
api_key=""
; Origin of a local IAPKit server for Local (IAPKit); empty uses kit.openiap.dev.
; An Android device on USB reaches the host through `adb reverse tcp:3100 tcp:3100`.
base_url=""
; true only for Amazon App Tester receipts, which verify against the RVS sandbox.
amazon_rvs_sandbox=false
