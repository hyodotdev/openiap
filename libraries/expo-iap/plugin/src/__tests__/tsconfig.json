// Editor-only: gives VS Code a project for these specs, which the package
// tsconfig excludes so expo-module-scripts keeps them out of build/. Without it,
// every Jest global errors with ts(2708). ts-jest type-checks specs at test time.
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["./**/*"],
  "exclude": []
}
