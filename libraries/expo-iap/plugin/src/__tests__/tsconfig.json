// Editor-only project for the Jest specs in this directory. The package
// tsconfig excludes __tests__ so expo-module-scripts never emits test files
// into build/, but that leaves VS Code without a project for them and every
// jest global errors with ts(2708). This config re-attaches the directory to
// the package compiler options; ts-jest still type-checks specs at test time.
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["./**/*"],
  "exclude": []
}
