{
  "name": "expo-iap-example",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "tvos": "EXPO_TV=1 npx expo run:ios",
    "tvos:prebuild": "EXPO_TV=1 npx expo prebuild --platform ios --clean",
    "build:vega:release": "node scripts/build-vega-example.mjs Release",
    "build:vega:debug": "node scripts/build-vega-example.mjs Debug",
    "run:vega:firetv": "node scripts/run-vega-firetv.mjs",
    "test:vega-config": "node --test scripts/vega-build-config.test.mjs",
    "eas:preview:android": "eas build --profile preview --platform android --local",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "ios:log": "idevicesyslog -u 00008101-0006455036D8001E | grep dev.hyo.martie"
  },
  "dependencies": {
    "@expo/react-native-action-sheet": "^4.1.1",
    "@expo/vector-icons": "^15.1.1",
    "@preact/signals-react": "^3.12.0",
    "@react-native-tvos/config-tv": "^0.1.6",
    "@react-navigation/bottom-tabs": "^7.18.16",
    "@react-navigation/native": "^7.3.16",
    "expo": "^58.1.0",
    "expo-blur": "~58.0.6",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "58.0.16",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.33",
    "expo-splash-screen": "~58.0.15",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "npm:react-native-tvos@0.88.1-0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "~0.13.0"
  },
  "devDependencies": {
    "@expo/env": "~2.4.2",
    "@babel/core": "^7.29.7",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "~19.3.3",
    "babel-jest": "^30.5.2",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.16",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "decode-uri-component": "0.5.1",
    "zod": "4.6.7",
    "expo-constants": "58.0.16",
    "fast-xml-parser": "5.12.0",
    "lodash": "4.18.1",
    "uuid": "11.1.1",
    "shell-quote": "1.12.0",
    "node-forge": "1.4.3",
    "joi": "17.13.9",
    "image-size": "2.0.3"
  },
  "private": true,
  "packageManager": "bun@1.3.13",
  "expo": {
    "autolinking": {
      "nativeModulesDir": ".."
    },
    "install": {
      "exclude": [
        "react-native",
        "react-native-reanimated",
        "react-native-worklets"
      ]
    }
  },
  "patchedDependencies": {
    "decode-uri-component@0.5.1": "patches/decode-uri-component@0.5.1.patch",
    "metro@0.76.9": "patches/metro@0.76.9.patch"
  }
}
