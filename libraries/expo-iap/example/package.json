{
  "name": "expo-iap-example",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "tvos": "EXPO_TV=1 npx expo run:ios",
    "tvos:prebuild": "EXPO_TV=1 npx expo prebuild --platform ios --clean",
    "vega:prebuild": "node scripts/build-vega-example.mjs Debug",
    "build:vega:release": "node scripts/build-vega-example.mjs Release",
    "build:vega:debug": "node scripts/build-vega-example.mjs Debug",
    "run:vega:firetv": "node scripts/run-vega-firetv.mjs",
    "test:vega-config": "node --test scripts/vega-build-config.test.mjs",
    "eas:preview:android": "eas build --profile preview --platform android --local",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "ios:log": "idevicesyslog -u 00008101-0006455036D8001E | grep dev.hyo.martie"
  },
  "dependencies": {
    "@amazon-devices/keplerscript-appstore-iap-lib": "~2.13.0",
    "@expo/react-native-action-sheet": "^4.1.1",
    "@expo/vector-icons": "^15.1.1",
    "@preact/signals-react": "^3.12.0",
    "@react-native-tvos/config-tv": "^0.1.6",
    "@react-navigation/bottom-tabs": "^7.18.16",
    "@react-navigation/native": "^7.3.16",
    "expo": "^57.0.12",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.10",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "57.0.10",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.12",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-native": "npm:react-native-tvos@0.86.2-0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "~0.10.4"
  },
  "devDependencies": {
    "@expo/env": "~2.4.2",
    "@babel/core": "^7.29.7",
    "@react-native-community/cli": "11.4.1",
    "@react-native/babel-preset": "0.76.9",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "^0.72.12",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.18",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3",
    "@amazon-devices/kepler-cli-platform": "~0.22.14",
    "@amazon-devices/kepler-compatibility-metro-config": "^0.0.7",
    "@amazon-devices/kepler-module-resolver-preset": "^0.1.16"
  },
  "overrides": {
    "expo-constants": "57.0.10",
    "fast-xml-parser": "5.7.0",
    "lodash": "4.18.1",
    "uuid": "11.1.1",
    "toml": "^4.1.2"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": ".."
    },
    "install": {
      "exclude": [
        "react-native",
        "react-native-reanimated",
        "react-native-worklets"
      ]
    }
  },
  "optionalDependencies": {
    "@amazon-devices/react-native-kepler": "^2.1.0"
  },
  "kepler": {
    "projectType": "application",
    "appName": "ExpoIAPExample",
    "targets": [
      "tv"
    ],
    "os": [
      "vega"
    ],
    "api": 0.1
  }
}
