# IAPKit publishable key for mobile purchase verification.
# Hosted keys: https://kit.openiap.dev
# Local (IAPKit): use an openiap-kit_pk_ key issued by the same Convex deployment.
# Never put an openiap-kit_sk_ secret admin key in an app build.
EXPO_PUBLIC_IAPKIT_API_KEY=openiap-kit_pk_your_publishable_key_here
# Required when selecting Local (IAPKit). Use your Mac's LAN IP on a device.
# Example: http://192.168.0.10:3100
EXPO_PUBLIC_IAPKIT_BASE_URL=
