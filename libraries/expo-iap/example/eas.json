{
  "cli": {
    "version": ">= 16.31.0"
  },
  "build": {
    "base": {
      "bun": "1.3.13"
    },
    "development": {
      "extends": "base",
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "extends": "base",
      "channel": "preview",
      "cache": {
        "disabled": true
      },
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "cache": {
        "disabled": true
      }
    },
    "quest": {
      "extends": "base",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "ORG_GRADLE_PROJECT_openiapStore": "horizon"
      }
    },
    "fire": {
      "extends": "base",
      "env": {
        "ORG_GRADLE_PROJECT_openiapStore": "amazon"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
